# Disable directory listing
Options -Indexes

# Block access to .git directory and return 404
RewriteEngine On
RewriteRule ^\.git(/.*|$) - [L,R=404,NC]

# Block access to uploads directory listing
<IfModule mod_autoindex.c>
	IndexIgnore *
</IfModule>
  # Block WordPress xmlrpc.php requests
    <Files xmlrpc.php>
        Order Deny,Allow
        Deny from all
    </Files>
# BEGIN WordPress
# The directives (lines) between "BEGIN WordPress" and "END WordPress" are
# dynamically generated, and should only be modified via WordPress filters.
# Any changes to the directives between these markers will be overwritten.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_HOST} !^dfes.goa.gov.in [NC]
    RewriteRule ^(.*)$ https://dfes.goa.gov.in/$1 [L,R=301]

    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    RewriteBase /
    RewriteRule ^index\.php$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.php [L]
</IfModule>

<IfModule mod_headers.c>
    # 1. Referrer-Policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # 2. COEP: Change from 'require-corp' to 'unsafe-none'
    # This allows the page to load cross-origin resources that don't have CORP headers.
    Header set Cross-Origin-Embedder-Policy "unsafe-none"

    # 3. COOP: Change from 'same-origin' to 'same-origin-allow-popups'
    # This is more flexible for external integrations.
    Header set Cross-Origin-Opener-Policy "same-origin-allow-popups"

    # 4. CORP: Change from 'same-origin' to 'cross-origin'
    # CRITICAL: This explicitly tells the browser it is safe for other domains (like Google)
    # to read this resource.
    Header set Cross-Origin-Resource-Policy "cross-origin"

    Header set Access-Control-Allow-Origin "https://docs.google.com"
    Header set Access-Control-Allow-Methods "GET, OPTIONS"
</IfModule>

ErrorDocument 404 /wp-content/themes/xevso-child/404.php
ErrorDocument 403 /wp-content/themes/xevso-child/404.php

# END WordPress
