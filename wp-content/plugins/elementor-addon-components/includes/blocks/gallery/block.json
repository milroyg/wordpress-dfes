{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "eac-blocks/gallery",
    "title": "EAC Gallery",
    "category": "widgets",
    "icon": "grid-view",
    "description": "Display ACF gallery as block",
    "keywords": ["acf", "grid", "gallery"],
    "textdomain": "eac-components",
    "editorStyle": "file:./assets/css/editor.css",
    "supports": {
        "html": false,
        "reusable": false,
        "customClassName": true,
        "visibility": false
    },
    "example": {
        "attributes": {
            "previewImg": ""
        }
    },
    "attributes": {
        "previewImg": {
            "type": "string",
            "default": ""
        },
        "className": {
            "type": "string",
            "default": ""
        },
        "containerWidth": {
            "type": "string",
            "default": "container-none"
        },
        "selectedGallery": {
            "type": "string",
            "default": ""
        },
        "postSource": {
            "type": "string",
            "default": "current"
        },
        "postId": {
            "type": "number",
            "default": 0
        },
        "galleryCol": {
            "type": "object",
            "default": {
                "desktopCol": 6,
                "tabletLandCol": 6,
                "tabletCol": 5,
                "mobileLandCol": 5,
                "mobileCol": 3,
                "suffix": "Col"
            }
        },
        "galleryGap": {
            "type": "object",
            "default": {
                "gapMin": 1,
                "gapMax": 2,
                "gapClamp": ""
            }
        },
        "itemStyle": {
            "type": "string",
            "default": ""
        },
        "itemBorder": {
            "type": "object",
            "default": {
                "width": 0,
                "color": null
            }
        },
        "itemBorderRadius": {
            "type": "object",
            "default": {
                "width": 0,
                "unit": "px"
            }
        },
        "itemShadow": {
            "type": "object",
            "default": {
                "offsetX": 0,
                "offsetY": 0,
                "blur": 0,
                "spread": 0,
                "inset": null,
                "color": "",
                "unit": "px"
            }
        },
        "blockBackground": {
            "type": "string",
            "default": "#FFFFFF"
        },
        "itemBackground": {
            "type": "string",
            "default": "#FFFFFF"
        },
        "colorText": {
            "type": "string",
            "default": null
        },
       "fontText": {
            "type": "object",
            "default": {
                "fontMin": 0.9,
                "fontMax": 1.1,
                "fontClamp": ""
            }
        },
        "marginTopBottom": {
            "type": "object",
            "default": {
                "marginSup": 0,
                "marginInf": 0,
                "unit": "px"
            }
        },
        "alignmentHrzText": {
            "type": "string",
            "default": "start"
        },
        "alignmentVrtText": {
            "type": "string",
            "default": "start"
        },
        "imageSizes": {
            "type": "string",
            "default": "medium"
        },
        "imageRatio": {
            "type": "string",
            "default": ""
        },
        "imagePosition": {
            "type": "number",
            "default": "50"
        },
        "globalLink": {
            "type": "boolean",
            "default": false
        },
        "nofollowLink": {
            "type": "boolean",
            "default": false
        },
        "addDescription": {
            "type": "boolean",
            "default": false
        },
        "addFancybox": {
            "type": "boolean",
            "default": false
        },
        "headingCaption": {
            "type": "string",
            "default": "div"
        }
    }
}